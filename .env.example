# Public application origin; use your HTTPS deployment URL on Amplify.
APP_URL=http://localhost:3000
# Supabase Project Settings → API / API Keys (server-only values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Needed for admin-only account creation, listing, role changes and password resets.
# A legacy service_role key also works as this value. NEVER use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_key
# Supabase Connect panel → pooled runtime URL / direct or session-mode migration URL.
# URL-encode special characters in the database password. Keep these server-only.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres
