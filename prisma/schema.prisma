generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Team {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  nameKey String @unique @map("name_key") @db.VarChar(100)
  createdBy String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  members TeamMembership[]
  @@map("teams")
}
model TeamMembership {
  userId String @id @map("user_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  assignedBy String? @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @updatedAt @map("assigned_at") @db.Timestamptz(6)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  @@index([teamId])
  @@map("team_memberships")
}

model SalesImport {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  reportingMonth DateTime @map("reporting_month") @db.Date
  filename String @db.VarChar(255)
  rowCount Int @map("row_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  records SalesRecord[]
  @@index([ownerId, reportingMonth])
  @@map("sales_imports")
}
model SalesRecord {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  reportingMonth DateTime @map("reporting_month") @db.Date
  dateFromCsv DateTime? @map("date_from_csv") @db.Date
  name String @db.Text
  college String @db.Text
  emailId String? @map("email_id") @db.Text
  phone String? @db.Text
  whatsapp String? @db.Text
  programPlan String @map("program_plan") @db.Text
  totalAmountPaise Int? @map("total_amount")
  registrationAmountPaise Int? @map("registration_amount")
  comments String? @db.Text
  rawValues Json @default("{}") @map("raw_values")
  rowHash String @map("row_hash") @db.VarChar(64)
  sourceRow Int @map("source_row")
  importId String @map("import_id") @db.Uuid
  import SalesImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([ownerId, reportingMonth, rowHash])
  @@index([ownerId, reportingMonth, dateFromCsv])
  @@map("sales_records")
}

model RecoveryLead {
  linkChangeToken String? @map("link_change_token") @db.Uuid
  linkChangeUntil DateTime? @map("link_change_until") @db.Timestamptz(6)
  paidAt DateTime? @map("paid_at") @db.Timestamptz(6)
  comments String @default("") @db.Text
  assignedTo String? @map("assigned_to") @db.Uuid
  assignedBy String? @map("assigned_by") @db.Uuid
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz(6)
  id String @id @default(uuid()) @db.Uuid
  uploadedBy String @map("uploaded_by") @db.Uuid
  uploadId String @map("upload_id") @db.Uuid
  filename String @db.VarChar(255)
  sourceRow Int @map("source_row")
  timestamp String @map("timestamp") @db.Text
  studentName String @map("student_name") @db.Text
  studentPhone String @map("student_phone") @db.Text
  studentEmail String @map("student_email") @db.Text
  studentCollegeEmail String @map("student_college_email") @db.Text
  executiveName String @map("executive_name") @db.Text
  amountMentioned String @map("amount_mentioned") @db.Text
  registrationAmount String @default("") @map("registration_amount") @db.Text
  amountPaid String @default("") @map("amount_paid") @db.Text
  remainingAmount String @default("") @map("remaining_amount") @db.Text
  paymentLinks String @default("") @map("payment_links") @db.Text
  programPlan String @map("program_plan") @db.Text
  domain String @map("domain") @db.Text
  selectedMonth String @map("selected_month") @db.Text
  referrals String @map("referrals") @db.Text
  paymentStatus String @map("payment_status") @db.Text
  leadStatus String @map("lead_status") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([createdAt, id])
  @@index([paidAt])
  @@index([assignedTo, selectedMonth])
  @@index([selectedMonth])
  @@index([uploadId])
  @@map("recovery_leads")
}

model RecoveryPeriod {
  id String @id @default(uuid()) @db.Uuid
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt DateTime? @map("ended_at") @db.Timestamptz(6)
  startedBy String @map("started_by") @db.Uuid
  endedBy String? @map("ended_by") @db.Uuid
  @@map("recovery_periods")
}

model RecoveryPaymentJob {
  nextRequestAt DateTime? @map("next_request_at") @db.Timestamptz(6)
  id String @id @default(uuid()) @db.Uuid
  accountKey String @map("account_key") @db.Text
  selectedMonth String? @map("selected_month") @db.Text
  createdBy String @map("created_by") @db.Uuid
  status String @default("running") @db.Text
  lockToken String? @map("lock_token") @db.Uuid
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items RecoveryPaymentItem[]
  @@index([accountKey, createdAt])
  @@map("recovery_payment_jobs")
}
model RecoveryPaymentItem {
  position Int @default(0)
  id String @id @default(uuid()) @db.Uuid
  jobId String @map("job_id") @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  studentName String @map("student_name") @db.Text
  remainingAmount String @map("remaining_amount") @db.Text
  status String @default("pending") @db.Text
  attempts Int @default(0)
  reason String @default("") @db.Text
  url String @default("") @db.Text
  retryAt DateTime? @map("retry_at") @db.Timestamptz(6)
  job RecoveryPaymentJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  @@unique([jobId, leadId])
  @@index([jobId, status])
  @@index([jobId, position])
  @@map("recovery_payment_items")
}
model RecoveryPaymentLink {
  id String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  accountKey String @map("account_key") @db.Text
  amountPaise BigInt @map("amount_paise")
  reference String @unique @db.VarChar(40)
  providerId String? @unique @map("provider_id") @db.Text
  url String @default("") @db.Text
  status String @default("pending") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([leadId, accountKey])
  @@map("recovery_payment_links")
}

model RecoveryWebhookEvent {
  eventId String @id @map("event_id") @db.VarChar(255)
  payloadHash String @map("payload_hash") @db.Char(64)
  providerLinkId String @map("provider_link_id") @db.Text
  eventType String @map("event_type") @db.Text
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  @@map("recovery_webhook_events")
}

model RecoveryPaymentRevision {
  id String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  accountKey String @map("account_key") @db.Text
  executiveId String @map("executive_id") @db.Uuid
  oldRemaining String @map("old_remaining") @db.Text
  oldUrl String @map("old_url") @db.Text
  oldReference String? @unique @map("old_reference") @db.VarChar(40)
  oldProviderId String? @map("old_provider_id") @db.Text
  oldAmountPaise BigInt? @map("old_amount_paise")
  oldStatus String @default("") @map("old_status") @db.Text
  desiredAmount String @map("desired_amount") @db.Text
  amountPaise BigInt @map("amount_paise")
  newReference String @unique @map("new_reference") @db.VarChar(40)
  newProviderId String? @map("new_provider_id") @db.Text
  newUrl String @default("") @map("new_url") @db.Text
  newStatus String @default("") @map("new_status") @db.Text
  status String @default("pending") @db.Text
  error String @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([leadId, accountKey])
  @@map("recovery_payment_revisions")
}

model RecoverySheetChange {
  id BigInt @id @default(autoincrement())
  leadId String @map("lead_id") @db.Uuid
  oldMonth String? @map("old_month") @db.Text
  newMonth String? @map("new_month") @db.Text
  oldAssignedTo String? @map("old_assigned_to") @db.Uuid
  newAssignedTo String? @map("new_assigned_to") @db.Uuid
  patch Json? @db.JsonB
  @@index([oldAssignedTo, id], map: "recovery_sheet_change_owner_old")
  @@index([newAssignedTo, id], map: "recovery_sheet_change_owner_new")
  @@map("recovery_sheet_changes")
}

model RecoverySyncEpoch {
  singleton Boolean @id @default(true)
  floorId BigInt @map("floor_id")
  @@map("recovery_sync_epoch")
}

model RecoveryPaymentItemChange {
  id BigInt @id @default(autoincrement())
  jobId String @map("job_id") @db.Uuid
  itemId String @map("item_id") @db.Uuid
  @@index([jobId, id], map: "recovery_payment_item_changes_job")
  @@map("recovery_payment_item_changes")
}

model EmployeeIdentifier {
  decryptedPassword String? @map("decrypted_password")
  userId String @id @map("user_id") @db.Uuid
  employeeId String @unique @map("employee_id") @default(dbgenerated())
  @@map("employee_identifiers")
}
